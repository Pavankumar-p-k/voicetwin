# AssemblyAI (required) - https://www.assemblyai.com/ -> API key
ASSEMBLYAI_API_KEY=your_api_key_here

# Server
PORT=3000

# Credit discipline (Day 1: free tier, no card). Session cap in seconds (min 60).
# 180s = 3 min per session. Keep it short; every second is billed.
MAX_SESSION_SECONDS=180

# Token redemption window (1-600s). Client must open the WebSocket within this.
TOKEN_EXPIRES_SECONDS=300
